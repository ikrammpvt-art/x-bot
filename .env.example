# =====================================================================
# X (Twitter) Account Monitor & Grok-Style Explainer Bot Configuration
# =====================================================================

# ---------------------------------------------------------------------
# 1. Telegram Settings (100% FREE)
# ---------------------------------------------------------------------
# Create a bot via @BotFather on Telegram to get your token:
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram User ID, Group ID, or Channel ID (e.g. 123456789 or @your_channel):
# Tip: Message @userinfobot or @raw_data_bot on Telegram to find your chat ID.
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ---------------------------------------------------------------------
# 2. X (Twitter) Scraping Authentication (100% FREE - No $100/mo API fee)
# ---------------------------------------------------------------------
# The official X API charges $100+/month. Instead, we use your session cookies
# from a free burner/secondary account.
#
# HOW TO GET THESE COOKIES (Takes 30 seconds):
# 1. Open x.com in Chrome/Brave/Firefox (logged into a burner account)
# 2. Press F12 (Inspect) -> Go to "Application" tab -> "Cookies" -> "https://x.com"
# 3. Find and copy the value of 'auth_token' and 'ct0'
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# Optional fallback credentials (if not using cookies above):
TWITTER_USERNAME=
TWITTER_EMAIL=
TWITTER_PASSWORD=

# ---------------------------------------------------------------------
# 3. AI Explanation Engine (FREE Options like Grok)
# ---------------------------------------------------------------------
# Supported providers: gemini (Free, recommended), groq (Free), ollama (Free Local), xai (Paid Grok)
AI_PROVIDER=gemini

# Option A: Google Gemini (RECOMMENDED - 100% Free, No Credit Card Required)
# Generous free tier: 15 requests/min, 1,500 requests/day.
# Get free key in 1 click at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Option B: Groq (100% Free, Ultra-Fast Llama-3.3-70B)
# Get free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Option C: Ollama (100% Local & Free, No API keys)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Option D: Official xAI Grok API (Paid option if you specifically want official Grok)
XAI_API_KEY=
XAI_MODEL=grok-2-latest

# ---------------------------------------------------------------------
# 4. Monitoring & Polling Settings
# ---------------------------------------------------------------------
# Polling interval in minutes (as requested: 15 minutes)
CHECK_INTERVAL_MINUTES=15

# Path to list of accounts to monitor (or comma-separated string)
ACCOUNTS_FILE=accounts.txt

# Filter out regular retweets (True = notify on RTs, False = only original & quotes)
INCLUDE_RETWEETS=false

# Filter out replies (True = notify on every reply, False = only top-level posts)
INCLUDE_REPLIES=false

# On first launch, mark existing recent tweets as seen without sending notifications
# to prevent spamming your Telegram channel with old tweets.
INITIAL_SEED_ONLY=true
